{
  "name": "physim",
  "displayName": "Stormworks Physics Sensor Sim",
  "description": "%description%",
  "version": "1.2.0",
  "publisher": "shannon-toppo",
  "icon": "images/icon.png",
  "license": "MIT",
  "keywords": [
    "stormworks",
    "lifeboatapi",
    "lua",
    "microcontroller",
    "physics sensor"
  ],
  "bugs": {
    "url": "https://github.com/Shannon-toppo/PhySim/issues"
  },
  "homepage": "https://github.com/Shannon-toppo/PhySim#readme",
  "engines": {
    "vscode": "^1.73.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shannon-toppo/PhySim.git"
  },
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "extensionDependencies": [
    "NameousChangey.lifeboatapi"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "physim.open",
        "title": "%command.open.title%"
      },
      {
        "command": "physim.openMonitors",
        "title": "%command.openMonitors.title%"
      },
      {
        "command": "physim.reset",
        "title": "%command.reset.title%"
      },
      {
        "command": "physim.showLog",
        "title": "%command.showLog.title%"
      }
    ],
    "configuration": {
      "title": "Stormworks Physics Sensor Sim",
      "properties": {
        "physim.port": {
          "type": "number",
          "default": 14239,
          "description": "%config.physim.port.description%"
        },
        "physim.autoOpenOnSimulate": {
          "type": "boolean",
          "default": true,
          "description": "%config.physim.autoOpenOnSimulate.description%"
        },
        "physim.panel.openLocation": {
          "type": "string",
          "enum": [
            "beside",
            "newWindow"
          ],
          "enumDescriptions": [
            "%config.physim.panel.openLocation.enumDescriptions.beside%",
            "%config.physim.panel.openLocation.enumDescriptions.newWindow%"
          ],
          "default": "beside",
          "description": "%config.physim.panel.openLocation.description%"
        },
        "physim.autoInjectLibraryPath": {
          "type": "boolean",
          "default": true,
          "description": "%config.physim.autoInjectLibraryPath.description%"
        },
        "physim.monitors.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.physim.monitors.openInNewWindow.markdownDescription%"
        },
        "physim.monitors.useBuiltInOnWindows": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.physim.monitors.useBuiltInOnWindows.markdownDescription%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run copy-three",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "check:media": "tsc -p tsconfig.media.json",
    "check:package": "npx --yes @vscode/vsce ls | node ./scripts/check-package.mjs",
    "test": "npm run compile && node --test \"test/**/*.test.mjs\"",
    "copy-three": "node ./scripts/copy-three.js",
    "postinstall": "npm run copy-three"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.0.0",
    "@types/three": "^0.160.0",
    "@types/vscode": "^1.73.0",
    "eslint": "^10.6.0",
    "fengari": "^0.1.5",
    "globals": "^17.7.0",
    "three": "^0.160.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1"
  }
}
