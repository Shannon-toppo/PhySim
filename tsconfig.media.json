{
  // Type-checks the webview JS (media/*.js) via JSDoc annotations. No emit —
  // the webview loads the .js files directly through the importmap.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["media/*.js", "media/globals.d.ts"],
  "exclude": ["media/three"]
}
